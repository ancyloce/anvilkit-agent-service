{
  "openapi": "3.1.2",
  "info": {
    "title": "AnvilKit Agent Runtime Boundary API",
    "version": "p0-kernel",
    "description": "Canonical wire contract for the boundary between Agent Service and the separate Agent Runtime Units (ADR-022). Two parties serve this surface and each operation names which: a runtime unit serves task dispatch and reports its own release, and the Agent Service serves the governed Model Gateway and the controlled artifact and tool operations runtimes are permitted to call. A runtime unit reaches nothing else: it holds no provider credentials, no storage credentials, and no authority beyond the attempt it was dispatched. JSON Schema components remain authoritative; contract identity is canonical path, digest, lock, and commit."
  },
  "servers": [
    {
      "url": "https://runtime.internal.invalid",
      "description": "One Agent Runtime Unit release. Every unit serves this surface and nothing else."
    },
    {
      "url": "https://agent.internal.invalid/v1",
      "description": "The Agent Service runtime boundary. Only authenticated runtime workloads reach it."
    }
  ],
  "tags": [
    {
      "name": "Dispatch"
    },
    {
      "name": "Gateway"
    },
    {
      "name": "Controlled access"
    }
  ],
  "security": [
    {
      "workloadIdentity": [],
      "taskCredential": []
    }
  ],
  "paths": {
    "/task": {
