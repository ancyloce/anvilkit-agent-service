              }
            }
          },
          "400": {
            "description": "Stable contract problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "anvilkit://schema/problem-details?digest=sha256:d42f44ad527b3a165aca0c56ab00b2b01ea28e3f7bb8346850a5334a7f438087"
                }
