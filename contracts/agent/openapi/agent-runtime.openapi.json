        {
          "url": "https://runtime.internal.invalid",
          "description": "One Agent Runtime Unit release. Every unit serves this surface and nothing else."
        }
      ],
      "post": {
        "operationId": "dispatchAgentTask",
        "summary": "Execute exactly one physical attempt of one AgentTask and return a signed result.",
        "security": [
          {
            "workloadIdentity": [],
            "taskCredential": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestDigest"
          },
          {
            "$ref": "#/components/parameters/Traceparent"
          }
        ],
        "x-anvilkit-idempotency": {
          "scope": "attempt-and-operation",
          "sameKeySameDigest": "return-recorded-outcome",
          "sameKeyDifferentBytes": "IDEMPOTENCY_KEY_REUSED"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "anvilkit://schema/agent-task?digest=sha256:0db34f07c19ac81a3adacd43fc25d10f4c0168b5ca57c6bddd0a7374a0d32176"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed result proposal for the dispatched attempt.",
            "headers": {
              "Idempotency-Replayed": {
                "description": "true when a recorded semantic outcome is replayed.",
                "schema": {
                  "type": "boolean"
                }
              },
              "X-AnvilKit-Request-Digest": {
                "description": "Canonical request digest accepted for the operation.",
                "schema": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "anvilkit://schema/agent-runtime-result?digest=sha256:1a5d69d36daad9780502a62fb32ed6732f70bd8e5806ad80023a7ea978a8a7f8"
