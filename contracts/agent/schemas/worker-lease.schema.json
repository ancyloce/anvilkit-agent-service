{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/worker-lease.schema.json",
  "title": "WorkerLease contract",
  "description": "Bounded WorkerLease wire contract governed by PRD 0012.",
  "type": "object",
  "minProperties": 11,
  "maxProperties": 11,
  "required": [
    "kind",
    "taskId",
    "recoveryEpoch",
    "executionGeneration",
    "physicalAttemptId",
    "attemptNumber",
    "leaseEpoch",
    "owner",
    "issuedAt",
    "expiresAt",
    "fenceToken"
  ],
  "properties": {
    "kind": {
      "const": "WorkerLease"
    },
    "taskId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/TaskId"
    },
    "recoveryEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "executionGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "physicalAttemptId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/PhysicalAttemptId"
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "leaseEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/OpaqueId"
    },
    "issuedAt": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Timestamp"
    },
    "expiresAt": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Timestamp"
    },
    "fenceToken": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~-]+$"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "WorkerLease",
    "componentName": "anvilkit.contract.schema.worker-lease",
    "owner": "Agent Service Scheduler owner",
    "stability": "p0-kernel",
    "identityFields": [
      "/taskId",
      "/recoveryEpoch",
      "/executionGeneration",
      "/physicalAttemptId",
      "/attemptNumber",
      "/leaseEpoch",
      "/owner",
      "/issuedAt",
      "/expiresAt",
      "/fenceToken"
    ],
    "maximumSerializedBytes": 16384,
    "descriptions": [
      "contracts/agent/asyncapi/agent-events.asyncapi.json"
    ]
