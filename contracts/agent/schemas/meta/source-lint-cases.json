{
  "caseVersion": 1,
  "base": {
    "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
    "$id": "https://contracts.anvilkit.dev/agent/schemas/profile-self-test.schema.json",
    "title": "Profile self test",
    "type": "object",
    "required": ["id", "value"],
    "properties": {
      "id": {"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9-]+$"},
      "value": {"type":"string","minLength":0,"maxLength":256},
      "note": {"type":["string","null"],"minLength":0,"maxLength":256,"x-anvilkit-nullSemantics":"null explicitly clears the note"}
    },
    "minProperties": 2,
    "maxProperties": 3,
    "unevaluatedProperties": false,
    "x-anvilkit-omittedSemantics": {"note":"absence preserves the current note"},
    "x-anvilkit-contract": {
      "logicalId": "ProfileSelfTest",
      "componentName": "anvilkit.contract.schema.profile-self-test",
      "owner": "Platform Contracts owner",
      "stability": "experimental",
      "identityFields": ["/id", "/value"],
      "maximumSerializedBytes": 1024,
      "descriptions": []
    }
  },
  "cases": [
    {"id":"valid-profile","mutations":[],"expectedCodes":[]},
    {"id":"wrong-dialect","mutations":[{"op":"set","path":"/$schema","value":"https://json-schema.org/draft/2020-12/schema"}],"expectedCodes":["AK-SRC-001"]},
    {"id":"missing-owner","mutations":[{"op":"delete","path":"/x-anvilkit-contract/owner"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"forbidden-semantic-version","mutations":[{"op":"set","path":"/x-anvilkit-contract/semanticVersion","value":"1.0.0"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"forbidden-compatibility-policy","mutations":[{"op":"set","path":"/x-anvilkit-contract/compatibilityPolicy","value":"frozen-major"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"versioned-logical-id","mutations":[{"op":"set","path":"/x-anvilkit-contract/logicalId","value":"ProfileSelfTestV1"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"versioned-component-name","mutations":[{"op":"set","path":"/x-anvilkit-contract/componentName","value":"anvilkit.contract.schema.profile-self-test.v1"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"versioned-schema-id","mutations":[{"op":"set","path":"/$id","value":"https://contracts.anvilkit.dev/schemas/v1/profile-self-test.schema.json"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"versioned-title","mutations":[{"op":"set","path":"/title","value":"Profile self test v1"}],"expectedCodes":["AK-SRC-002"]},
    {"id":"invalid-identity-pointer","mutations":[{"op":"set","path":"/x-anvilkit-contract/identityFields","value":["id"]}],"expectedCodes":["AK-SRC-002"]},
    {"id":"invalid-size-bound","mutations":[{"op":"set","path":"/x-anvilkit-contract/maximumSerializedBytes","value":0}],"expectedCodes":["AK-SRC-002"]},
    {"id":"invalid-description-path","mutations":[{"op":"set","path":"/x-anvilkit-contract/descriptions","value":["https://example.com/openapi.json"]}],"expectedCodes":["AK-SRC-002"]},
    {"id":"unknown-keyword","mutations":[{"op":"set","path":"/properties/value/unknownKeyword","value":true}],"expectedCodes":["AK-SRC-003"]},
    {"id":"unknown-vocabulary","mutations":[{"op":"set","path":"/$vocabulary/https:~1~1example.com~1vocab","value":true}],"expectedCodes":["AK-SRC-003"]},
    {"id":"dynamic-reference","mutations":[{"op":"set","path":"/properties/value/$dynamicRef","value":"#value"}],"expectedCodes":["AK-SRC-003"]},
    {"id":"nested-resource-id","mutations":[{"op":"set","path":"/properties/value/$id","value":"nested-resource"}],"expectedCodes":["AK-SRC-003"]},
    {"id":"open-object","mutations":[{"op":"delete","path":"/unevaluatedProperties"}],"expectedCodes":["AK-SRC-004"]},
    {"id":"unbounded-object","mutations":[{"op":"delete","path":"/maxProperties"}],"expectedCodes":["AK-SRC-006"]},
    {"id":"unbounded-string","mutations":[{"op":"delete","path":"/properties/value/maxLength"}],"expectedCodes":["AK-SRC-005"]},
    {"id":"unbounded-array","mutations":[{"op":"set","path":"/properties/value","value":{"type":"array","items":{"type":"string","minLength":0,"maxLength":16}}}],"expectedCodes":["AK-SRC-006"]},
    {"id":"unbounded-number","mutations":[{"op":"set","path":"/properties/value","value":{"type":"number","minimum":0}}],"expectedCodes":["AK-SRC-007","AK-SRC-014"]},
    {"id":"null-without-semantics","mutations":[{"op":"delete","path":"/properties/note/x-anvilkit-nullSemantics"}],"expectedCodes":["AK-SRC-008"]},
    {"id":"omitted-without-semantics","mutations":[{"op":"delete","path":"/x-anvilkit-omittedSemantics"}],"expectedCodes":["AK-SRC-009"]},
    {"id":"unsupported-format","mutations":[{"op":"set","path":"/properties/value/format","value":"uri"}],"expectedCodes":["AK-SRC-010"]},
    {"id":"timestamp-profile","mutations":[{"op":"set","path":"/properties/value/format","value":"date-time"}],"expectedCodes":["AK-SRC-011"]},
    {"id":"nonportable-regex","mutations":[{"op":"set","path":"/properties/value/pattern","value":"^(a+)+$"}],"expectedCodes":["AK-SRC-012"]},
    {"id":"invalid-decimal-string-profile","mutations":[{"op":"set","path":"/properties/value/x-anvilkit-decimalString","value":true}],"expectedCodes":["AK-SRC-015"]},
    {"id":"invalid-integer-string-profile","mutations":[{"op":"set","path":"/properties/value/x-anvilkit-integerString","value":true}],"expectedCodes":["AK-SRC-015"]},
    {"id":"executable-content","mutations":[{"op":"set","path":"/properties/value/contentMediaType","value":"application/javascript"}],"expectedCodes":["AK-SRC-013"]},
    {"id":"external-reference","mutations":[{"op":"set","path":"/$ref","value":"https://example.com/other.schema.json"}],"expectedCodes":["AK-REF-001"]},
    {"id":"versioned-reference","mutations":[{"op":"set","path":"/$ref","value":"anvilkit://schema/example.v1@1.0.0?digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}],"expectedCodes":["AK-REF-002"]},
    {"id":"mutable-reference","mutations":[{"op":"set","path":"/$ref","value":"anvilkit://schema/example@latest?digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}],"expectedCodes":["AK-REF-002"]},
    {"id":"missing-reference-digest","mutations":[{"op":"set","path":"/$ref","value":"anvilkit://schema/example"}],"expectedCodes":["AK-REF-003"]},
    {"id":"reference-graph-escape","mutations":[{"op":"set","path":"/$ref","value":"../other.schema.json"}],"expectedCodes":["AK-REF-008"]}
  ]
}
