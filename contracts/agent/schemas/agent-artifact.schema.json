{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/agent-artifact.schema.json",
  "title": "AgentArtifact contract",
  "description": "Bounded AgentArtifact wire contract governed by PRD 0012.",
  "type": "object",
  "minProperties": 11,
  "maxProperties": 11,
  "required": [
    "contractType",
    "artifactId",
    "kind",
    "schema",
    "digest",
    "reference",
    "lineage",
    "producer",
    "validation",
    "lifecycle",
    "createdAt"
  ],
  "properties": {
    "contractType": {
      "const": "AgentArtifact"
    },
    "artifactId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ArtifactId"
    },
    "kind": {
      "enum": [
        "compiled-context",
        "target-snapshot",
        "agent-plan",
        "worker-result",
        "validation-report"
      ]
    },
    "schema": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/SchemaReference"
    },
    "digest": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
    },
    "reference": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": [
        "bucket",
        "objectKey",
        "sizeBytes",
        "mediaType"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ArtifactReference"
      }
    },
    "producer": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "taskId",
        "recoveryEpoch",
        "executionGeneration",
        "physicalAttemptId",
        "leaseEpoch"
      ],
      "properties": {
        "taskId": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/TaskId"
        },
        "recoveryEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executionGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "physicalAttemptId": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/PhysicalAttemptId"
        },
        "leaseEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "required": [
        "validatedAt",
        "checks"
      ],
      "properties": {
        "validatedAt": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Timestamp"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "minProperties": 3,
            "maxProperties": 3,
            "required": [
              "name",
              "result",
              "evidenceDigest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "result": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "evidenceDigest": {
                "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "enum": [
        "pending",
        "scanning",
        "valid",
        "finalized",
        "committed",
        "quarantined",
        "expired",
        "deleted"
      ]
    },
    "createdAt": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Timestamp"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "AgentArtifact",
    "componentName": "anvilkit.contract.schema.agent-artifact",
    "owner": "Agent Service Metadata owner",
    "stability": "p0-kernel",
    "identityFields": [
      "/artifactId",
      "/kind",
      "/schema",
      "/digest",
      "/reference",
      "/lineage",
      "/producer",
      "/validation",
      "/lifecycle"
    ],
    "maximumSerializedBytes": 32768,
    "descriptions": [
      "contracts/agent/openapi/agent-service.openapi.json",
      "contracts/agent/openapi/pagix-agent-integration.openapi.json"
    ]
  }
}
