{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/contract-signature-statement.schema.json",
  "title": "ContractSignatureStatement contract",
  "description": "Canonical context-bound statement carried by a standard single-signature DSSE envelope.",
  "type": "object",
  "minProperties": 10,
  "maxProperties": 10,
  "required": [
    "kind",
    "subject",
    "contractBomDigest",
    "issuer",
    "audience",
    "keyId",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "algorithm"
  ],
  "properties": {
    "kind": {
      "const": "ContractSignatureStatement"
    },
    "subject": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": [
        "digest",
        "size",
        "purpose",
        "mediaType"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[!-~]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
        }
      },
      "additionalProperties": false
    },
    "contractBomDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer": {
      "const": "urn:anvilkit:issuer:contracts-release"
    },
    "audience": {
      "const": "urn:anvilkit:audience:contract-consumers"
    },
    "keyId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^urn:anvilkit:key:[a-z0-9][a-z0-9:-]*$"
    },
    "issuedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "notBefore": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "algorithm": {
      "const": "dsse-ed25519-v1"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "ContractSignatureStatement",
    "componentName": "anvilkit.contract.schema.contract-signature-statement",
    "owner": "Security and Platform Contracts",
    "stability": "p0-kernel",
    "identityFields": [
      "/subject",
      "/contractBomDigest",
      "/issuer",
      "/audience",
      "/keyId",
      "/issuedAt",
      "/notBefore",
      "/expiresAt",
      "/algorithm"
    ],
    "maximumSerializedBytes": 8192,
    "descriptions": []
  }
}
