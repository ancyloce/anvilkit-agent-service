{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/page-preview-task.schema.json",
  "title": "PagePreviewTask contract",
  "description": "Bounded input payload for one deterministic page-preview render, carried as an artifact input on the canonical worker lease envelope rather than as a second task family. It names the PageCandidate and its digest, the resolved catalog snapshot, approved assets, and exact Puck schema and runtime revisions, the viewport/locale/theme matrix to render, a deterministic runtime profile whose network policy is deny-all, the render deadline and resource bounds, and the contract, catalog, and runtime digests the worker must verify before rendering. It carries inputs only: no credential, no endpoint selection, and no authority to commit, approve, or publish anything it renders.",
  "type": "object",
  "minProperties": 9,
  "maxProperties": 9,
  "required": [
    "kind",
    "candidate",
    "candidateDigest",
    "resolved",
    "matrix",
    "runtimeProfile",
    "deadlineAt",
    "limits",
    "expected"
  ],
  "properties": {
    "kind": {
      "const": "PagePreviewTask"
    },
    "candidate": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ArtifactReference"
    },
    "candidateDigest": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
    },
    "resolved": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": [
        "catalogSnapshot",
        "approvedAssets",
        "puckSchemaRevision",
        "puckRuntimeRevision"
      ],
      "properties": {
        "catalogSnapshot": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ArtifactReference"
        },
        "approvedAssets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ArtifactReference"
          }
        },
        "puckSchemaRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "puckRuntimeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "minProperties": 4,
        "maxProperties": 4,
        "required": [
          "viewportWidth",
          "viewportHeight",
          "locale",
          "theme"
        ],
        "properties": {
          "viewportWidth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7680
          },
          "viewportHeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7680
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?(-[A-Za-z0-9]{2,8})?(-[A-Za-z0-9]{2,8})?$"
          },
          "theme": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "additionalProperties": false
      }
    },
    "runtimeProfile": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": [
        "deterministicSeed",
        "timezone",
        "reducedMotion",
        "networkPolicy"
      ],
      "properties": {
        "deterministicSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_+/-]{0,63}$"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "networkPolicy": {
          "enum": [
            "deny-all"
          ]
        }
      },
      "additionalProperties": false
    },
    "deadlineAt": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Timestamp"
    },
    "limits": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ResourceLimits"
    },
    "expected": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": [
        "contractBomDigest",
        "catalogDigest",
        "runtimeDigest"
      ],
      "properties": {
        "contractBomDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "catalogDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "runtimeDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "PagePreviewTask",
    "componentName": "anvilkit.contract.schema.page-preview-task",
    "owner": "Page Preview Worker owner",
    "stability": "p0-kernel",
    "identityFields": [
      "/candidate",
      "/candidateDigest",
      "/resolved",
      "/matrix",
      "/runtimeProfile",
      "/deadlineAt",
      "/limits",
      "/expected"
    ],
    "maximumSerializedBytes": 262144,
    "descriptions": []
  }
}
