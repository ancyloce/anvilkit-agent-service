{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/agent-runtime-result.schema.json",
  "title": "AgentRuntimeResult contract",
  "description": "Signed, bounded result returned by one Agent Runtime Unit for exactly one AgentTask attempt. It reports which definition, runtime manifest, invocation protocol, and image digests actually served the attempt, the physical attempt identity and execution generation it belongs to, the metered usage it consumed, one bounded TurnDecision, safe coded diagnostics, and its signature and provenance references. It is a proposal that Agent Service validates and may reject: it never carries authoritative workflow state, never commits, approves, or publishes, and never names another Agent Runtime Unit to call.",
  "type": "object",
  "minProperties": 12,
  "maxProperties": 12,
  "required": [
    "kind",
    "taskId",
    "runId",
    "rootRunId",
    "physicalAttemptId",
    "executionGeneration",
    "selected",
    "turnDecision",
    "usage",
    "diagnostics",
    "provenance",
    "traceContext"
  ],
  "properties": {
    "kind": {
      "const": "AgentRuntimeResult"
    },
    "taskId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/TaskId"
    },
    "runId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/RunId"
    },
    "rootRunId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/RunId"
    },
    "physicalAttemptId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/PhysicalAttemptId"
    },
    "executionGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selected": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "required": [
        "definitionDigest",
        "runtimeManifestDigest",
        "invocationProtocolDigest",
        "imageDigest"
      ],
      "properties": {
        "definitionDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "runtimeManifestDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "invocationProtocolDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "imageDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "turnDecision": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": [
        "decision",
        "payload",
        "artifactOutputs"
      ],
      "properties": {
        "decision": {
          "enum": [
            "continue",
            "tool_call",
            "delegate_agent",
            "need_input",
            "final",
            "refuse"
          ]
        },
        "payload": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/BoundedStringMap"
        },
        "artifactOutputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/ArtifactReference"
          }
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": [
        "inputTokens",
        "outputTokens",
        "durationMilliseconds"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "minProperties": 2,
        "maxProperties": 2,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": [
        "signatureAlgorithm",
        "signatureDigest",
        "statementDigest"
      ],
      "properties": {
        "signatureAlgorithm": {
          "enum": [
            "dsse-ed25519-v1",
            "jws-eddsa-v1"
          ]
        },
        "signatureDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "statementDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "traceContext": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/TraceContext"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "AgentRuntimeResult",
    "componentName": "anvilkit.contract.schema.agent-runtime-result",
    "owner": "Agent Service Scheduler owner",
    "stability": "p0-kernel",
    "identityFields": [
      "/taskId",
      "/runId",
      "/rootRunId",
      "/physicalAttemptId",
      "/executionGeneration",
      "/selected",
      "/turnDecision",
      "/usage",
      "/provenance"
    ],
    "maximumSerializedBytes": 65536,
    "descriptions": []
  }
}
