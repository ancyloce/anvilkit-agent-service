        "system": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "user": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tools": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memory": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
