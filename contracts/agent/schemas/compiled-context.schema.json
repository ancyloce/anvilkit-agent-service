  "properties": {
    "kind": {
      "const": "CompiledContext"
    },
    "orderedTrustLayers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "minProperties": 6,
        "maxProperties": 6,
        "required": [
          "layerId",
          "position",
          "digest",
          "classification",
          "redacted",
          "tokenBudget"
