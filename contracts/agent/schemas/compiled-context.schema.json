        "properties": {
          "layerId": {
            "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/OpaqueId"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1023
          },
          "digest": {
            "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "redacted": {
            "type": "boolean"
          },
          "tokenBudget": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    "layerDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ]
      },
      "uniqueItems": true
    },
    "redaction": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": [
        "policy",
        "removedFieldCount",
        "replacementMarker"
