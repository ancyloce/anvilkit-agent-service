{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/compiled-context.schema.json",
  "title": "CompiledContext contract",
  "description": "Bounded CompiledContext wire contract governed by PRD 0012.",
  "type": "object",
  "minProperties": 8,
  "maxProperties": 8,
  "required": [
    "kind",
    "orderedTrustLayers",
    "layerDigests",
    "classifications",
    "redaction",
    "tokenBudgets",
    "policySnapshot",
    "compiledAt"
