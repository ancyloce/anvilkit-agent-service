  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "CompiledContext",
    "componentName": "anvilkit.contract.schema.compiled-context",
    "owner": "Agent Service Context Compiler owner",
    "stability": "p0-kernel",
    "identityFields": [
      "/orderedTrustLayers",
      "/layerDigests",
      "/classifications",
      "/redaction",
      "/tokenBudgets",
      "/policySnapshot"
    ],
    "maximumSerializedBytes": 262144,
    "descriptions": [
      "contracts/agent/openapi/agent-service.openapi.json"
    ]
  }
