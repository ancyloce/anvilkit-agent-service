        },
        "removedFieldCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "replacementMarker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "tokenBudgets": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "total",
        "system",
        "user",
        "tools",
        "memory"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
