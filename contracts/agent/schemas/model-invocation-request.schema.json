    "physicalAttemptId",
    "attemptNumber",
    "executionGeneration",
    "definition",
    "modelPolicy",
    "contextDigest",
    "promptDigest",
    "limits",
    "idempotency",
    "traceContext",
    "contractBomReference"
  ],
