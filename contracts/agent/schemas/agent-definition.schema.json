{
  "$schema": "https://contracts.anvilkit.dev/agent/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/agent/schemas/agent-definition.schema.json",
  "title": "AgentDefinition contract",
  "description": "Bounded AgentDefinition wire contract governed by PRD 0012 and ADR-018. A definition is immutable by definitionId and definitionDigest and carries role, owner, instruction digest, input/output schema identity, Tool profile, delegation constraints, repair policy, and evaluation profile. The runtime binding names the one runtime release permitted to execute this definition — unit, manifest digest, image digest, invocation protocol digest, and workload audience. It is an immutable pin, not a mutable discovery hint.",
  "type": "object",
  "minProperties": 21,
  "maxProperties": 21,
  "required": [
    "kind",
    "role",
    "owner",
    "domain",
    "promptDigest",
    "inputSchema",
    "outputSchema",
    "toolProfile",
    "modelPolicy",
    "memoryPolicy",
    "guardrailPolicy",
    "repairPolicy",
    "allowedDelegates",
    "maximumDelegationDepth",
    "maximumFanOut",
    "turnLimit",
    "stopConditions",
    "evaluators",
    "runtimeBinding",
    "definitionId",
    "definitionDigest"
  ],
  "properties": {
    "kind": {
      "const": "AgentDefinition"
    },
    "role": {
      "enum": [
        "manager",
        "specialist"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "domain": {
      "enum": [
        "platform-agent",
        "pagix-page",
        "contract-runtime"
      ]
    },
    "promptDigest": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
    },
    "inputSchema": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/SchemaReference"
    },
    "outputSchema": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/SchemaReference"
    },
    "toolProfile": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "required": [
        "tools",
        "maximumParallelTools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/SchemaReference"
          }
        },
        "maximumParallelTools": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "modelPolicy": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/PolicyReference"
    },
    "memoryPolicy": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/PolicyReference"
    },
    "guardrailPolicy": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/PolicyReference"
    },
    "repairPolicy": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "required": [
        "maximumAttempts",
        "mode"
      ],
      "properties": {
        "maximumAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "mode": {
          "enum": [
            "reject",
            "bounded-repair"
          ]
        }
      },
      "additionalProperties": false
    },
    "allowedDelegates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/OpaqueId"
      }
    },
    "maximumDelegationDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "maximumFanOut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "turnLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": [
          "completed",
          "refused",
          "budget-exhausted",
          "approval-required",
          "input-required",
          "policy-blocked"
        ]
      },
      "uniqueItems": true
    },
    "evaluators": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/SchemaReference"
      }
    },
    "runtimeBinding": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "runtimeUnitId",
        "runtimeManifestDigest",
        "runtimeImageDigest",
        "invocationProtocolDigest",
        "runtimeAudience"
      ],
      "properties": {
        "runtimeUnitId": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/OpaqueId"
        },
        "runtimeManifestDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "runtimeImageDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "invocationProtocolDigest": {
          "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
        },
        "runtimeAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^urn:anvilkit:audience:[a-z0-9][a-z0-9-]{1,63}$"
        }
      },
      "additionalProperties": false
    },
    "definitionId": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/OpaqueId"
    },
    "definitionDigest": {
      "$ref": "anvilkit://schema/shared-primitives?digest=sha256:49d3142e660e7835a4b99a2e9479c4b21709a197829279f5191daa247fcc6576#/$defs/Digest"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "AgentDefinition",
    "componentName": "anvilkit.contract.schema.agent-definition",
    "owner": "Platform Definitions owner",
    "stability": "p0-kernel",
    "identityFields": [
      "/role",
      "/owner",
      "/domain",
      "/promptDigest",
      "/inputSchema",
      "/outputSchema",
      "/toolProfile",
      "/modelPolicy",
      "/memoryPolicy",
      "/guardrailPolicy",
      "/repairPolicy",
      "/allowedDelegates",
      "/maximumDelegationDepth",
      "/maximumFanOut",
      "/turnLimit",
      "/stopConditions",
      "/evaluators",
      "/runtimeBinding",
      "/definitionId"
    ],
    "maximumSerializedBytes": 65536,
    "descriptions": [
      "contracts/agent/openapi/agent-service.openapi.json"
    ]
  }
}
