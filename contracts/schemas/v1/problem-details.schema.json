{
  "$schema": "https://contracts.anvilkit.dev/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/schemas/v1/problem-details.schema.json",
  "title": "ProblemDetailsV1 contract",
  "description": "Bounded ProblemDetailsV1 wire contract governed by PRD 0012.",
  "type": "object",
  "minProperties": 6,
  "maxProperties": 9,
  "required": [
    "apiVersion",
    "kind",
    "code",
    "retryability",
    "message",
    "fieldErrors"
  ],
  "properties": {
    "apiVersion": {
      "const": "anvilkit.io/contracts/v1"
    },
    "kind": {
      "const": "ProblemDetails"
    },
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_.-]+$"
    },
    "retryability": {
      "enum": [
        "never",
        "safe-immediate",
        "safe-after-backoff",
        "after-input",
        "after-approval",
        "after-rebase",
        "operator-action"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "fieldErrors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "minProperties": 4,
        "maxProperties": 4,
        "required": [
          "code",
          "instancePath",
          "schemaPath",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[A-Z][A-Z0-9_.-]+$"
          },
          "instancePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/.*$"
          },
          "schemaPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/.*$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "runId": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/RunId"
    },
    "traceId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-omittedSemantics": {
    "stage": "omitted when failure is not associated with a workflow stage",
    "runId": "omitted when failure occurs before run allocation",
    "traceId": "omitted only when no trace was established"
  },
  "x-anvilkit-contract": {
    "logicalId": "ProblemDetailsV1",
    "semanticVersion": "1.0.0",
    "componentName": "anvilkit.contract.schema.problem-details.v1",
    "owner": "Platform Contracts owner",
    "stability": "p0-freeze-candidate",
    "identityFields": [
      "/code",
      "/retryability",
      "/fieldErrors",
      "/stage",
      "/runId",
      "/traceId"
    ],
    "maximumSerializedBytes": 32768,
    "compatibilityPolicy": "frozen-major",
    "descriptions": [
      "contracts/openapi/v1/agent-service.openapi.json",
      "contracts/openapi/v1/pagix-agent-integration.openapi.json",
      "contracts/asyncapi/v1/agent-events.asyncapi.json",
      "contracts/asyncapi/v1/pagix-domain-events.asyncapi.json"
    ]
  }
}
