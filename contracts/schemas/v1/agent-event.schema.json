{
  "$schema": "https://contracts.anvilkit.dev/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/schemas/v1/agent-event.schema.json",
  "title": "AgentEventV1 contract",
  "description": "Bounded AgentEventV1 wire contract governed by PRD 0012.",
  "type": "object",
  "minProperties": 9,
  "maxProperties": 12,
  "required": [
    "apiVersion",
    "kind",
    "eventId",
    "runId",
    "sequence",
    "eventType",
    "occurredAt",
    "traceContext",
    "contractBomReference"
  ],
  "properties": {
    "apiVersion": {
      "const": "anvilkit.io/contracts/v1"
    },
    "kind": {
      "const": "AgentEvent"
    },
    "eventId": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/OpaqueId"
    },
    "runId": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/RunId"
    },
    "taskId": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/TaskId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventType": {
      "enum": [
        "run.created",
        "run.state-changed",
        "run.input-requested",
        "run.approval-requested",
        "run.artifact-available",
        "run.problem-recorded"
      ]
    },
    "occurredAt": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/Timestamp"
    },
    "traceContext": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/TraceContext"
    },
    "payload": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/BoundedStringMap"
    },
    "artifactReference": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/ArtifactReference"
    },
    "contractBomReference": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/ContractBomReferenceV1"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-omittedSemantics": {
    "taskId": "omitted for run-level events",
    "payload": "omitted when the event body is carried by artifact reference",
    "artifactReference": "omitted when the bounded inline payload is present"
  },
  "x-anvilkit-contract": {
    "logicalId": "AgentEventV1",
    "semanticVersion": "1.0.0",
    "componentName": "anvilkit.contract.schema.agent-event.v1",
    "owner": "Agent Service Events owner",
    "stability": "p0-freeze-candidate",
    "identityFields": [
      "/eventId",
      "/runId",
      "/taskId",
      "/sequence",
      "/eventType",
      "/occurredAt",
      "/traceContext",
      "/payload",
      "/artifactReference"
    ],
    "maximumSerializedBytes": 32768,
    "compatibilityPolicy": "frozen-major",
    "descriptions": [
      "contracts/openapi/v1/agent-service.openapi.json",
      "contracts/asyncapi/v1/agent-events.asyncapi.json"
    ]
  }
