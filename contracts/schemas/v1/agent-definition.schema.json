{
  "$schema": "https://contracts.anvilkit.dev/schemas/meta/anvilkit-2020-12.schema.json",
  "$id": "https://contracts.anvilkit.dev/schemas/v1/agent-definition.schema.json",
  "title": "AgentDefinitionV1 contract",
  "description": "Bounded AgentDefinitionV1 wire contract governed by PRD 0012.",
  "type": "object",
  "minProperties": 14,
  "maxProperties": 14,
  "required": [
    "apiVersion",
    "kind",
    "domain",
    "promptDigest",
    "toolProfile",
    "outputSchema",
    "modelPolicy",
    "memoryPolicy",
    "guardrailPolicy",
    "turnLimit",
    "stopConditions",
    "evaluators",
    "definitionId",
    "version"
  ],
  "properties": {
    "apiVersion": {
      "const": "anvilkit.io/contracts/v1"
    },
    "kind": {
      "const": "AgentDefinition"
    },
    "domain": {
      "enum": [
        "platform-agent",
        "pagix-page",
        "contract-runtime"
      ]
    },
    "promptDigest": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/Digest"
    },
    "toolProfile": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "required": [
        "tools",
        "maximumParallelTools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/SchemaReference"
          }
        },
        "maximumParallelTools": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/SchemaReference"
    },
    "modelPolicy": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/PolicyReference"
    },
    "memoryPolicy": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/PolicyReference"
    },
    "guardrailPolicy": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/PolicyReference"
    },
    "turnLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": [
          "completed",
          "refused",
          "budget-exhausted",
          "approval-required",
          "input-required",
          "policy-blocked"
        ]
      },
      "uniqueItems": true
    },
    "evaluators": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/SchemaReference"
      }
    },
    "definitionId": {
      "$ref": "anvilkit://schema/shared-primitives.v1@1.0.0?digest=sha256:de45a3a2412afca14c4386afe8fd750621366e1ec826928e336639936f814592#/$defs/OpaqueId"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    }
  },
  "additionalProperties": false,
  "x-anvilkit-contract": {
    "logicalId": "AgentDefinitionV1",
    "semanticVersion": "1.0.0",
    "componentName": "anvilkit.contract.schema.agent-definition.v1",
    "owner": "Platform Definitions owner",
    "stability": "p0-freeze-candidate",
    "identityFields": [
      "/domain",
      "/promptDigest",
      "/toolProfile",
      "/outputSchema",
      "/modelPolicy",
      "/memoryPolicy",
      "/guardrailPolicy",
      "/turnLimit",
      "/stopConditions",
      "/evaluators"
    ],
    "maximumSerializedBytes": 65536,
    "compatibilityPolicy": "frozen-major",
    "descriptions": [
      "contracts/openapi/v1/agent-service.openapi.json"
    ]
  }
}
